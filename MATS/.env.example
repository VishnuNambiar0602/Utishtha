# ============================================================================
# MATS ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to Git (it's in .gitignore)
# ============================================================================

# ----------------------------------------------------------------------------
# GOOGLE GEMINI API (Required)
# ----------------------------------------------------------------------------
# Get from: https://console.cloud.google.com/
# Used for: AI call analysis, symptom extraction, dispatch recommendations
VITE_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ----------------------------------------------------------------------------
# SUPABASE (Required)
# ----------------------------------------------------------------------------
# Get from: Supabase Dashboard → Settings → API
# Used for: Database, file storage, real-time updates

# Your Supabase project URL (e.g., https://xxxxx.supabase.co)
VITE_SUPABASE_URL=https://xxxxx.supabase.co

# Your Supabase anonymous key (starts with eyJhbGc...)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: Supabase publishable key
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# ----------------------------------------------------------------------------
# GRASP2026 MEDICAL DIAGNOSIS API (Required)
# ----------------------------------------------------------------------------
# This is your EC2 instance IP address where GRASP2026 backend is deployed
# Format: http://YOUR_EC2_IP (no trailing slash)
# Example: http://54.123.45.67

# For local development:
# VITE_GRASP2026_API_URL=http://localhost:5000

# For production (replace with your EC2 IP):
VITE_GRASP2026_API_URL=http://your_ec2_ip_here

# ----------------------------------------------------------------------------
# NOTES
# ----------------------------------------------------------------------------
# 1. All variables starting with VITE_ are embedded in the frontend build
# 2. These values will be visible to users in the browser
# 3. Use Supabase Row Level Security (RLS) to protect sensitive data
# 4. Rotate API keys regularly for security
# 5. Never share this file or commit it to version control
# ============================================================================
